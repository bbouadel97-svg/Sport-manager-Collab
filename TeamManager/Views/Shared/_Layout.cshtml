
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sport Manager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Teams" asp-action="Index">Sport Manager</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Teams" asp-action="Index">Équipes</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Players" asp-action="Index">Joueurs</a></li>
            </ul>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>
</body>
</html>