@model TeamManager.DTOs.RegisterRequest
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inscription - Sport Manager</title>
</head>
<body>
<main>
    <h1>Créer un compte</h1>
    @Html.ValidationSummary()
    <form method="post" action="/account/register">
        @Html.AntiForgeryToken()
        <label for="name">Nom</label>
        <input id="name" name="Name" value="@Model.Name" maxlength="120" required />
        <label for="email">E-mail</label>
        <input id="email" name="Email" type="email" value="@Model.Email" required />
        <label for="password">Mot de passe (8 caractères minimum)</label>
        <input id="password" name="Password" type="password" minlength="8" maxlength="128" required />
        <button type="submit">Créer mon compte</button>
    </form>
    <p><a href="/account/login">J’ai déjà un compte</a></p>
</main>
</body>
</html>
