@page "/positions"
@rendermode InteractiveServer
@inject PositionService PositionService
@inject IJSRuntime JS

<PageTitle>Positions</PageTitle>

<h1>Positions</h1>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @statusCssClass" role="alert">@statusMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@(isEditMode ? "Edit Position" : "Add Position")</h5>
        <EditForm Model="formPosition" OnValidSubmit="SavePositionAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Position Name</label>
                    <InputText class="form-control" @bind-Value="formPosition.Name" />
                    <ValidationMessage For="() => formPosition.Name" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Needed Speed</label>
                    <InputNumber class="form-control" @bind-Value="formPosition.NeededSpeed" />
                    <ValidationMessage For="() => formPosition.NeededSpeed" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Needed Endurance</label>
                    <InputNumber class="form-control" @bind-Value="formPosition.NeededEndurance" />
                    <ValidationMessage For="() => formPosition.NeededEndurance" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Needed Strength</label>
                    <InputNumber class="form-control" @bind-Value="formPosition.NeededStrength" />
                    <ValidationMessage For="() => formPosition.NeededStrength" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Needed Technique</label>
                    <InputNumber class="form-control" @bind-Value="formPosition.NeededTechnique" />
                    <ValidationMessage For="() => formPosition.NeededTechnique" />
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@(isEditMode ? "Update Position" : "Add Position")</button>
                @if (isEditMode)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                }
            </div>
        </EditForm>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Needed Speed</th>
            <th>Needed Endurance</th>
            <th>Needed Strength</th>
            <th>Needed Technique</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (positions.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No positions yet.</td>
            </tr>
        }

        @foreach (var position in positions)
        {
            <tr>
                <td>@position.Name</td>
                <td>@position.NeededSpeed</td>
                <td>@position.NeededEndurance</td>
                <td>@position.NeededStrength</td>
                <td>@position.NeededTechnique</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => StartEdit(position)">Edit</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePositionAsync(position.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private Position formPosition = CreateEmptyPosition();
    private bool isEditMode;
    private List<Position> positions = new();
    private string statusMessage = string.Empty;
    private string statusCssClass = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task SavePositionAsync()
    {
        try
        {
            if (isEditMode)
            {
                await PositionService.UpdateAsync(formPosition);
                ShowSuccess("Position updated successfully.");
            }
            else
            {
                await PositionService.AddAsync(formPosition);
                ShowSuccess("Position created successfully.");
            }

            CancelEdit();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    private void StartEdit(Position position)
    {
        isEditMode = true;
        formPosition = new Position
        {
            Id = position.Id,
            Name = position.Name,
            NeededSpeed = position.NeededSpeed,
            NeededEndurance = position.NeededEndurance,
            NeededStrength = position.NeededStrength,
            NeededTechnique = position.NeededTechnique
        };
    }

    private void CancelEdit()
    {
        isEditMode = false;
        formPosition = CreateEmptyPosition();
    }

    private async Task DeletePositionAsync(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this position?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await PositionService.DeleteAsync(id);
            ShowSuccess("Position deleted successfully.");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    private async Task LoadDataAsync()
    {
        positions = await PositionService.GetAllAsync();
    }

    private static Position CreateEmptyPosition()
    {
        return new Position
        {
            NeededSpeed = 50,
            NeededEndurance = 50,
            NeededStrength = 50,
            NeededTechnique = 50
        };
    }

    private void ShowSuccess(string message)
    {
        statusMessage = message;
        statusCssClass = "alert-success";
    }

    private void ShowError(string message)
    {
        statusMessage = message;
        statusCssClass = "alert-danger";
    }
}

