@page "/"

<PageTitle>Sport Manager</PageTitle>

<h1>Sport Manager</h1>

<p class="lead">Simple school project to manage teams, players, matches, and injuries.</p>

<div class="row g-3">
	<div class="col-md-4">
		<div class="card h-100">
			<div class="card-body">
				<h5 class="card-title">Teams</h5>
				<p class="card-text">Create teams and assign coaches.</p>
				<a href="teams" class="btn btn-primary">Open Teams</a>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card h-100">
			<div class="card-body">
				<h5 class="card-title">Players</h5>
				<p class="card-text">Add players with team and position.</p>
				<a href="players" class="btn btn-primary">Open Players</a>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card h-100">
			<div class="card-body">
				<h5 class="card-title">Matches</h5>
				<p class="card-text">Schedule matches and store scores.</p>
				<a href="matches" class="btn btn-primary">Open Matches</a>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card h-100">
			<div class="card-body">
				<h5 class="card-title">Positions</h5>
				<p class="card-text">Manage position names.</p>
				<a href="positions" class="btn btn-outline-primary">Open Positions</a>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card h-100">
			<div class="card-body">
				<h5 class="card-title">Injuries</h5>
				<p class="card-text">Track injuries and recovery status.</p>
				<a href="injuries" class="btn btn-outline-primary">Open Injuries</a>
			</div>
		</div>
	</div>
</div>
